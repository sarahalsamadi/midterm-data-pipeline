# MongoDB connection string
# Default for MongoDB running on the same machine:
MONGODB_URI=mongodb://localhost:27017/

# WSL users connecting to MongoDB running on Windows may need to use
# the Windows/WSL gateway IP instead, for example:
# MONGODB_URI=mongodb://172.x.x.x:27017/
# Optional Spark temporary/local working directory.
# Leave unset to use Spark's default system temporary directory.
#
# Example for WSL:
# SPARK_LOCAL_DIR=/mnt/d/spark-temp
#
# Example for Linux:
# SPARK_LOCAL_DIR=/tmp/spark-temp
